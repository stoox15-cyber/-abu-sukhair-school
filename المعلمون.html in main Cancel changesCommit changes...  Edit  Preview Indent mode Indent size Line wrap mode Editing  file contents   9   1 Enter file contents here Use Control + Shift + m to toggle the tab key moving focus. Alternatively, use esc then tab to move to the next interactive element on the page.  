}

.teacher-icon{
width:75px;
height:75px;
border-radius:50%;
background:#e8f3ed;
display:flex;
align-items:center;
justify-content:center;
font-size:38px;
flex-shrink:0;
}

.teacher h3{
margin:0 0 8px;
font-size:23px;
color:#276b48;
}

.teacher p{
margin:0;
font-size:17px;
color:#555;
}

.back{
display:block;
width:260px;
margin:30px auto;
padding:17px;
text-align:center;
background:#276b48;
color:white;
text-decoration:none;
border-radius:20px;
font-size:20px;
}

.back:hover{
background:#1d5639;
}
