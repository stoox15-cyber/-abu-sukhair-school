margin:12px 0 0;
}

.container{
max-width:900px;
margin:25px auto;
padding:15px;
}

.news{
background:white;
padding:22px;
margin-bottom:18px;
border-radius:20px;
box-shadow:0 4px 15px #00000012;
}

.news h2{
color:#075b3a;
margin-top:0;
}

.news p{
font-size:18px;
line-height:1.8;
}

.date{
color:#777;
font-size:14px;
}

button{
display:block;
margin:25px auto;
padding:14px 25px;
border:0;
border-radius:12px;
background:#075b3a;
color:white;
